DATABASE_URL=postgresql://<user>@localhost:5433/civicfix
TEST_DATABASE_URL=postgresql://<user>@localhost:5433/civicfix_test

# Authentication (app/auth.py). Point these at your identity provider's
# JWKS/issuer/audience. Local development: `python -m scripts.dev_auth init`
# prints values for a local-only issuer. Unset -> authenticated endpoints 503.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
# AUTH_ALGORITHMS=RS256

# Show generated test complaints (reports.is_synthetic). Developer machines only;
# leave unset or 0 on any deployment the public or PMC can reach.
SHOW_TEST_DATA=0
# Encrypts evidence photos at rest. Generate once and share out of band, never commit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset = photos stored unencrypted, and each upload records stored_encrypted=false.
PHOTO_ENCRYPTION_KEY=
# LLM triage fallback (app/nlp/triage.py): complaints the classifier can't
# place are sorted into accept / review / likely-spam by Claude Haiku 4.5.
# Unset = off; those complaints go to manual review as before.
ANTHROPIC_API_KEY=
